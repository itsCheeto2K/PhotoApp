<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#121212"
  android:fillViewport="true"
  tools:context=".ViewUserActivity">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top section: Left Info & Right Avatar -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <!-- Left Column: User Details -->
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="12dp">

        <TextView
          android:id="@+id/tv_detail_username"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Tên người dùng"
          android:textColor="#00E5FF"
          android:textSize="20sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tv_detail_id"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="Mã ID: 1"
          android:textColor="#AAAAAA"
          android:textSize="13sp" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="Email:"
          android:textColor="#80D8FF"
          android:textSize="13sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tv_detail_email"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:text="user@example.com"
          android:textColor="#E0E0E0"
          android:textSize="14sp" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="Sở thích:"
          android:textColor="#80D8FF"
          android:textSize="13sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tv_detail_hobby"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:text="Lập trình, Âm nhạc, Nhiếp ảnh"
          android:textColor="#E0E0E0"
          android:textSize="14sp" />

      </LinearLayout>

      <!-- Right Column: Avatar with Download Progress Bar -->
      <LinearLayout
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
          android:layout_width="140dp"
          android:layout_height="140dp">

          <ImageView
            android:id="@+id/iv_detail_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#2A2A2A"
            android:scaleType="centerCrop"
            android:contentDescription="Ảnh đại diện" />

          <ProgressBar
            android:id="@+id/pb_download_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
        </FrameLayout>

        <ProgressBar
          android:id="@+id/pb_download_progress"
          style="?android:attr/progressBarStyleHorizontal"
          android:layout_width="match_parent"
          android:layout_height="8dp"
          android:layout_marginTop="6dp"
          android:max="100"
          android:progress="0"
          android:progressTint="#00E5FF"
          android:visibility="visible" />

        <TextView
          android:id="@+id/tv_download_status"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:text="Đang tải ảnh..."
          android:textColor="#AAAAAA"
          android:textSize="11sp" />

      </LinearLayout>

    </LinearLayout>

    <!-- Bottom Section: Full Description -->
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:text="Tiểu sử / Giới thiệu:"
      android:textColor="#FFB74D"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/tv_detail_description"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:lineSpacingMultiplier="1.2"
      android:text="Thông tin chi tiết giới thiệu về người dùng..."
      android:textColor="#EEEEEE"
      android:textSize="14sp" />

  </LinearLayout>
</ScrollView>
